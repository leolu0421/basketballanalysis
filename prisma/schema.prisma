generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  teams        Team[]
}

model Team {
  id        String    @id @default(cuid())
  name      String
  division  String?
  joinCode  String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  players   Player[]
  matches   Match[]
}

model Player {
  id           String      @id @default(cuid())
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  jerseyNumber String
  email        String?
  createdAt    DateTime    @default(now())
  statEvents   StatEvent[]
}

model Match {
  id              String      @id @default(cuid())
  teamId          String
  team            Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opponentName    String
  date            DateTime
  teamScore       Int?
  opponentScore   Int?
  youtubeVideoId  String?
  createdAt       DateTime    @default(now())
  statEvents      StatEvent[]
  insights        Insight[]
  videoAnalysisJobs VideoAnalysisJob[]
}

model Insight {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scope     String
  content   String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, scope])
}

model VideoAnalysisJob {
  id           String                   @id @default(cuid())
  matchId      String
  match        Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status       String                   @default("PENDING")
  progress     Int                      @default(0)
  errorMessage String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  candidates   VideoAnalysisCandidate[]
}

model VideoAnalysisCandidate {
  id                    String           @id @default(cuid())
  jobId                 String
  job                   VideoAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  videoTimestampSeconds Float
  previousScoreText     String?
  scoreText             String?
  dismissed             Boolean          @default(false)
  createdAt             DateTime         @default(now())
}

model StatEvent {
  id                     String   @id @default(cuid())
  matchId                String
  match                  Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId               String
  player                 Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type                   String
  quarter                Int      @default(1)
  videoTimestampSeconds  Float?
  shotX                  Float?
  shotY                  Float?
  createdAt              DateTime @default(now())
}
