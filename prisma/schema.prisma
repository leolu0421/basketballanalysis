generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  createdAt           DateTime             @default(now())
  teams               Team[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Team {
  id        String    @id @default(cuid())
  name      String
  division  String?
  joinCode  String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  players   Player[]
  matches   Match[]
}

model Player {
  id             String               @id @default(cuid())
  teamId         String
  team           Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  jerseyNumber   String
  email          String?
  createdAt      DateTime             @default(now())
  statEvents     StatEvent[]
  referenceStats ReferenceStatLine[]
}

model Match {
  id              String      @id @default(cuid())
  teamId          String
  team            Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opponentName    String
  date            DateTime
  teamScore       Int?
  opponentScore   Int?
  youtubeVideoId  String?
  videoFileName   String?
  // Benchmark matches are used to compare AI pipeline versions over time
  // (see AnalysisSummary) — deleteMatchAction refuses to delete one while
  // this is set, so a benchmark can't be lost by accident.
  isBenchmark     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  statEvents      StatEvent[]
  insights        Insight[]
  videoAnalysisJobs VideoAnalysisJob[]
  referenceStats  ReferenceStatLine[]
  analysisSummaries AnalysisSummary[]
}

model ReferenceStatLine {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fg2Made   Int      @default(0)
  fg3Made   Int      @default(0)
  ftMade    Int      @default(0)
  fouls     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
}

model Insight {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scope     String
  content   String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, scope])
}

model VideoAnalysisJob {
  id           String                   @id @default(cuid())
  matchId      String
  match        Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status       String                   @default("PENDING")
  progress     Int                      @default(0)
  errorMessage String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  candidates   VideoAnalysisCandidate[]
  summary      AnalysisSummary?
}

// Internal quality-assurance record, one per completed video-analysis job —
// not shown to coaches. Lets a later run be compared against an earlier one
// on the same benchmark match to see whether a pipeline change actually
// helped. extraMetrics holds anything not worth a dedicated column yet, so
// future metrics don't require a schema change to start collecting.
model AnalysisSummary {
  id                             String           @id @default(cuid())
  jobId                          String           @unique
  job                            VideoAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchId                        String
  match                          Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gitCommitHash                  String?
  analyzedAt                     DateTime         @default(now())
  // Raw scoreboard-text changes seen before the two-read confirmation
  // filter (see candidates.ts) -- always >= suggestedMomentsGenerated.
  scoreChangesDetected           Int
  // Confirmed candidates after filtering -- exactly what's shown as
  // "Suggested moments" in the coach-facing UI.
  suggestedMomentsGenerated      Int
  // localizationAttempts + skipped (implausible-delta candidates, or ones
  // routed to the legacy wide-frame fallback after an earlier tracking
  // failure -- not stored separately, but always ==
  // suggestedMomentsGenerated - localizationAttempts) always accounts for
  // every candidate. localizationAttempts == success + fallback + failed.
  localizationAttempts           Int
  // Localization found a real scoring frame via Claude vision.
  localizationSuccess            Int
  // Localization ran to completion but found no usable evidence (not an
  // error) -- extraction produced zero frames, or Claude found nothing
  // clear enough.
  localizationFallback           Int
  // Localization threw an actual exception (ffmpeg failure/timeout, an
  // API error) -- distinct from localizationFallback, which is an
  // expected "tried, nothing there" outcome, not a bug.
  localizationFailed             Int
  // Average confidence across localizationAttempts (success attempts
  // report a real confidence; fallback/failed attempts report 0).
  averageLocalizationConfidence  Float?
  totalProcessingSeconds         Float?
  extraMetrics                   Json?
  createdAt                      DateTime         @default(now())
}

model VideoAnalysisCandidate {
  id                     String           @id @default(cuid())
  jobId                  String
  job                    VideoAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // The localized scoring timestamp when event localization succeeded,
  // otherwise the scoreboard-gap midpoint (see localization.ts / pipeline.ts).
  videoTimestampSeconds  Float
  previousScoreText      String?
  scoreText              String?
  // Original scoreboard-change search window this candidate came from —
  // kept even after localization narrows videoTimestampSeconds down, so the
  // wider window is never lost.
  gapStartSeconds        Float?
  gapEndSeconds          Float?
  localizationConfidence Float?
  localizationMethod     String?
  guessedJerseyNumber    String?
  guessedStatType        String?
  guessedPlayerId        String?
  dismissed              Boolean          @default(false)
  createdAt              DateTime         @default(now())
}

model StatEvent {
  id                     String   @id @default(cuid())
  matchId                String
  match                  Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId               String
  player                 Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type                   String
  quarter                Int      @default(1)
  videoTimestampSeconds  Float?
  shotX                  Float?
  shotY                  Float?
  createdAt              DateTime @default(now())
}
