# Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres).
# Used for both local dev and production — see README for setup.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"

# Required for the Insights page to generate real AI analysis.
# Without it, Insights shows a "not configured" state instead of erroring.
ANTHROPIC_API_KEY=""

# Required for "Forgot password" emails to actually send. Get a free key at
# resend.com. Without it, the forgot-password form shows a "not configured"
# error instead of erroring silently.
RESEND_API_KEY=""
# Optional — defaults to Resend's unverified sandbox sender, which has
# deliverability limits. Set this once you've verified a domain in Resend.
RESEND_FROM_EMAIL=""

# Where directly-uploaded match videos are stored on disk (see README's
# "Direct video upload" section). Optional — defaults to a folder inside
# the project directory, which is fine for local dev but gets wiped on
# every deploy in production unless this points at a persistent volume
# (e.g. a Railway Volume mounted at /data/videos).
VIDEO_STORAGE_DIR=""
